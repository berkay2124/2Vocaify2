# ===================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================================================
# This file contains all environment variables needed for production.
# Copy this file to .env.production and fill in your actual values.
# NEVER commit .env.production to version control!
# ===================================================================

# -------------------------------------------------------------------
# FIREBASE CONFIGURATION (REQUIRED)
# -------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > General
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=your_production_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -------------------------------------------------------------------
# OPENAI CONFIGURATION (REQUIRED)
# -------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Used for:
# - CV text extraction (GPT-4o-mini)
# - Embedding generation (text-embedding-3-small)
# - Search result re-ranking (GPT-4o-mini)
# Estimated cost: $2-3/month for 1000 CVs + 1000 searches

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override default models
# OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_RERANK_MODEL=gpt-4o-mini

# -------------------------------------------------------------------
# PINECONE CONFIGURATION (REQUIRED)
# -------------------------------------------------------------------
# Get your API key from: https://app.pinecone.io/
# Create an index with these settings:
# - Name: vocaify-cvs-prod
# - Dimensions: 1536
# - Metric: cosine
# - Cloud: AWS (recommended) or GCP
# - Region: Choose closest to your users

PINECONE_API_KEY=your_pinecone_production_api_key_here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=vocaify-cvs-prod

# -------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -------------------------------------------------------------------
# Production URL (used for CORS, redirects, etc.)
NEXT_PUBLIC_APP_URL=https://vocaify.com

# Environment identifier
NODE_ENV=production

# Enable production optimizations
NEXT_TELEMETRY_DISABLED=1

# -------------------------------------------------------------------
# SECURITY CONFIGURATION
# -------------------------------------------------------------------
# Secret for signing tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_here_minimum_32_characters_long

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://vocaify.com,https://www.vocaify.com

# Rate limiting (requests per minute per user)
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_SEARCHES=30
RATE_LIMIT_API=60

# -------------------------------------------------------------------
# MONITORING & ANALYTICS (OPTIONAL)
# -------------------------------------------------------------------
# Sentry for error tracking
# Get from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Google Analytics (if not using Firebase Analytics)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# LogRocket for session replay (optional)
# NEXT_PUBLIC_LOGROCKET_APP_ID=your-app-id/vocaify

# -------------------------------------------------------------------
# PERFORMANCE & OPTIMIZATION
# -------------------------------------------------------------------
# Image optimization
NEXT_PUBLIC_IMAGE_DOMAINS=firebasestorage.googleapis.com

# Cache configuration
CACHE_TTL_SEARCH_RESULTS=300
CACHE_TTL_CV_METADATA=600

# Batch processing limits
MAX_CONCURRENT_UPLOADS=10
MAX_CV_FILE_SIZE=10485760

# -------------------------------------------------------------------
# CLOUD FUNCTIONS CONFIGURATION
# -------------------------------------------------------------------
# These are set in Firebase Functions config, not .env
# Run: firebase functions:config:set key=value
#
# Examples:
# firebase functions:config:set openai.api_key="sk-..."
# firebase functions:config:set pinecone.api_key="..."
# firebase functions:config:set pinecone.environment="us-east-1-aws"
# firebase functions:config:set pinecone.index="vocaify-cvs-prod"

# -------------------------------------------------------------------
# BACKUP & DISASTER RECOVERY (OPTIONAL)
# -------------------------------------------------------------------
# Secondary storage for backups
# BACKUP_BUCKET_NAME=vocaify-backups-prod

# Backup retention (days)
# BACKUP_RETENTION_DAYS=90

# -------------------------------------------------------------------
# EMAIL CONFIGURATION (OPTIONAL)
# -------------------------------------------------------------------
# For transactional emails (welcome, notifications, etc.)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SENDGRID_FROM_EMAIL=noreply@vocaify.com
# SENDGRID_FROM_NAME=Vocaify

# -------------------------------------------------------------------
# FEATURE FLAGS (OPTIONAL)
# -------------------------------------------------------------------
# Enable/disable features without redeploying
NEXT_PUBLIC_FEATURE_ADVANCED_FILTERS=true
NEXT_PUBLIC_FEATURE_BULK_ACTIONS=true
NEXT_PUBLIC_FEATURE_ANALYTICS_DASHBOARD=false
NEXT_PUBLIC_FEATURE_TEAM_COLLABORATION=false

# -------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# -------------------------------------------------------------------
# GitHub Actions secrets (not in .env, set in GitHub)
# FIREBASE_TOKEN - Get with: firebase login:ci
# FIREBASE_SERVICE_ACCOUNT - From Firebase Console

# Vercel/Netlify (if using instead of Firebase Hosting)
# VERCEL_TOKEN=your_vercel_token
# VERCEL_ORG_ID=your_org_id
# VERCEL_PROJECT_ID=your_project_id

# -------------------------------------------------------------------
# DEVELOPMENT HELPERS (DO NOT SET IN PRODUCTION)
# -------------------------------------------------------------------
# These should NEVER be enabled in production:
# NEXT_PUBLIC_DEBUG_MODE=false
# NEXT_PUBLIC_DISABLE_AUTH=false
# NEXT_PUBLIC_USE_EMULATORS=false
