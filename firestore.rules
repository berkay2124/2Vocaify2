rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // MULTI-TENANT RBAC HELPER FUNCTIONS
    // ============================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    function getUserOrg() {
      return getUserProfile().organizationId;
    }

    function getUserRole() {
      return getUserProfile().role;
    }

    function isSameOrg(orgId) {
      return isAuthenticated() && getUserOrg() == orgId;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuthenticated() && getUserRole() == 'manager';
    }

    function isRecruiter() {
      return isAuthenticated() && getUserRole() == 'recruiter';
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function canManageTeam() {
      return isAdmin();
    }

    function canUploadCVs() {
      return isAdmin() || isManager();
    }

    function canViewAllCVs() {
      return isAdmin() || isManager();
    }

    function canDeleteCVs() {
      return isAdmin() || isManager();
    }

    function isValidString(field, minLen, maxLen) {
      return field is string &&
             field.size() >= minLen &&
             field.size() <= maxLen;
    }

    function isValidRole(role) {
      return role in ['admin', 'manager', 'recruiter'];
    }

    function isValidStatus(status) {
      return status in ['pending', 'processing', 'indexed', 'error'];
    }

    function isValidFileType(type) {
      return type in [
        'application/pdf',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/msword'
      ];
    }

    // ============================================================================
    // ORGANIZATIONS COLLECTION
    // ============================================================================

    match /organizations/{orgId} {
      // Anyone in the org can read org data
      allow read: if isSameOrg(orgId);

      // Only owner (admin) can create
      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'name', 'ownerId', 'createdAt', 'memberIds', 'subscriptionStatus'
                       ]) &&
                       isValidString(request.resource.data.name, 2, 100);

      // Only admin can update
      allow update: if isSameOrg(orgId) && isAdmin() &&
                       resource.data.ownerId == request.resource.data.ownerId; // Can't change owner

      // Only admin can delete (soft delete recommended)
      allow delete: if isSameOrg(orgId) && isAdmin();
    }

    // ============================================================================
    // USER PROFILES COLLECTION
    // ============================================================================

    match /userProfiles/{userId} {
      // Users can read their own profile, org admins can read all in org
      allow read: if request.auth.uid == userId ||
                     (isSameOrg(resource.data.organizationId) && isAdmin());

      // Create during signup/invitation
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'uid', 'email', 'displayName', 'organizationId', 'role', 'createdAt', 'isActive'
                       ]) &&
                       isValidRole(request.resource.data.role);

      // Users can update their own profile (limited fields), admins can update roles
      allow update: if (request.auth.uid == userId &&
                        request.resource.data.uid == resource.data.uid &&
                        request.resource.data.organizationId == resource.data.organizationId &&
                        request.resource.data.role == resource.data.role) ||
                       (isSameOrg(resource.data.organizationId) && isAdmin() &&
                        request.resource.data.uid == resource.data.uid &&
                        request.resource.data.organizationId == resource.data.organizationId);

      // Only admins can delete (deactivate recommended)
      allow delete: if isSameOrg(resource.data.organizationId) && isAdmin();
    }

    // ============================================================================
    // ORGANIZATION INVITATIONS
    // ============================================================================

    match /invitations/{invitationId} {
      // Invited user can read their invitation, org admins can read all
      allow read: if isAuthenticated() &&
                     (request.auth.token.email == resource.data.email ||
                      (isSameOrg(resource.data.organizationId) && isAdmin()));

      // Only admins can create invitations
      allow create: if isAuthenticated() &&
                       isSameOrg(request.resource.data.organizationId) &&
                       isAdmin() &&
                       request.resource.data.invitedBy == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'organizationId', 'email', 'role', 'invitedBy', 'createdAt', 'status', 'token'
                       ]) &&
                       isValidRole(request.resource.data.role);

      // User can update to accept/reject, admin can cancel
      allow update: if (isAuthenticated() &&
                        request.auth.token.email == resource.data.email &&
                        resource.data.status == 'pending') ||
                       (isSameOrg(resource.data.organizationId) && isAdmin());

      // Only admins can delete
      allow delete: if isSameOrg(resource.data.organizationId) && isAdmin();
    }

    // ============================================================================
    // CVS COLLECTION - MULTI-TENANT + RBAC
    // ============================================================================

    match /cvs/{cvId} {
      // Admins and managers can view all CVs in org, recruiters can only view assigned
      allow read: if isAuthenticated() &&
                     isSameOrg(resource.data.organizationId) &&
                     (canViewAllCVs() ||
                      (isRecruiter() && resource.data.assignedRecruiters.hasAny([request.auth.uid])));

      // Only admins and managers can create CVs
      allow create: if isAuthenticated() &&
                       canUploadCVs() &&
                       request.resource.data.organizationId == getUserOrg() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'organizationId', 'userId', 'storagePath', 'filename',
                         'uploadedAt', 'status', 'fileSize', 'fileType'
                       ]) &&
                       isValidString(request.resource.data.filename, 1, 255) &&
                       isValidString(request.resource.data.storagePath, 1, 1024) &&
                       isValidStatus(request.resource.data.status) &&
                       isValidFileType(request.resource.data.fileType) &&
                       request.resource.data.fileSize is int &&
                       request.resource.data.fileSize >= 100 &&
                       request.resource.data.fileSize <= 10485760;

      // Admins and managers can update, preserve immutable fields
      allow update: if isAuthenticated() &&
                       isSameOrg(resource.data.organizationId) &&
                       canViewAllCVs() &&
                       request.resource.data.organizationId == resource.data.organizationId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.storagePath == resource.data.storagePath &&
                       request.resource.data.uploadedAt == resource.data.uploadedAt;

      // Only admins and managers can delete
      allow delete: if isAuthenticated() &&
                       isSameOrg(resource.data.organizationId) &&
                       canDeleteCVs();
    }

    // ============================================================================
    // SHORTLISTS COLLECTION - MULTI-TENANT + RBAC
    // ============================================================================

    match /shortlists/{shortlistId} {
      // Users can read shortlists in their org
      allow read: if isAuthenticated() &&
                     isSameOrg(resource.data.organizationId);

      // Any authenticated org member can create shortlist
      allow create: if isAuthenticated() &&
                       request.resource.data.organizationId == getUserOrg() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'organizationId', 'userId', 'cvId', 'candidateName', 'addedAt'
                       ]) &&
                       isValidString(request.resource.data.cvId, 1, 255) &&
                       isValidString(request.resource.data.candidateName, 1, 255);

      // Owner or admin can update
      allow update: if isAuthenticated() &&
                       isSameOrg(resource.data.organizationId) &&
                       (resource.data.userId == request.auth.uid || isAdmin()) &&
                       request.resource.data.organizationId == resource.data.organizationId;

      // Owner or admin can delete
      allow delete: if isAuthenticated() &&
                       isSameOrg(resource.data.organizationId) &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================================================
    // REJECTED CANDIDATES - MULTI-TENANT + RBAC
    // ============================================================================

    match /rejected/{rejectionId} {
      // Users can read rejected in their org
      allow read: if isAuthenticated() &&
                     isSameOrg(resource.data.organizationId);

      // Any authenticated org member can create rejection
      allow create: if isAuthenticated() &&
                       request.resource.data.organizationId == getUserOrg() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'organizationId', 'userId', 'cvId', 'rejectedAt'
                       ]) &&
                       isValidString(request.resource.data.cvId, 1, 255);

      // Owner or admin can delete
      allow delete: if isAuthenticated() &&
                       isSameOrg(resource.data.organizationId) &&
                       (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ============================================================================
    // SEARCH ANALYTICS - MULTI-TENANT
    // ============================================================================

    match /searchAnalytics/{analyticsId} {
      // Users can read their own analytics, admins can read all in org
      allow read: if isAuthenticated() &&
                     isSameOrg(resource.data.organizationId) &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Create with org context
      allow create: if isAuthenticated() &&
                       request.resource.data.organizationId == getUserOrg() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasAll([
                         'organizationId', 'userId', 'query', 'timestamp'
                       ]);

      // No updates or deletes
      allow update, delete: if false;
    }

    // ============================================================================
    // RECENT SEARCHES - MULTI-TENANT
    // ============================================================================

    match /recentSearches/{userId} {
      // Own searches only
      allow read: if request.auth.uid == userId;

      // Create/update with validation
      allow create, update: if isAuthenticated() &&
                               request.auth.uid == userId &&
                               request.resource.data.userId == request.auth.uid &&
                               request.resource.data.searches is list &&
                               request.resource.data.searches.size() <= 10;

      allow delete: if request.auth.uid == userId;
    }

    // ============================================================================
    // DENY ALL OTHER ACCESS
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/**
 * MULTI-TENANT SECURITY NOTES:
 *
 * 1. DATA ISOLATION:
 *    - All documents MUST include organizationId
 *    - All queries MUST filter by organizationId
 *    - No cross-organization data access allowed
 *
 * 2. ROLE-BASED ACCESS CONTROL (RBAC):
 *    - Admin: Full access to organization data
 *    - Manager: Upload CVs, view all, manage shortlists
 *    - Recruiter: View assigned shortlists only, search only
 *
 * 3. REQUIRED FIELDS:
 *    - organizations: name, ownerId, memberIds, subscriptionStatus
 *    - userProfiles: uid, email, organizationId, role, isActive
 *    - cvs: organizationId + all previous fields
 *    - shortlists: organizationId + all previous fields
 *
 * 4. SECURITY AUDIT CHECKLIST:
 *    ✓ getUserProfile() reads from userProfiles collection
 *    ✓ All org checks use isSameOrg()
 *    ✓ RBAC enforced via role checks
 *    ✓ Immutable fields protected
 *    ✓ No direct userId matching (use org context)
 *
 * 5. PERFORMANCE CONSIDERATIONS:
 *    - getUserProfile() is cached per request
 *    - Use composite indexes for org + status queries
 *    - Required indexes:
 *      * cvs: [organizationId ASC, status ASC, uploadedAt DESC]
 *      * shortlists: [organizationId ASC, userId ASC, addedAt DESC]
 *      * rejected: [organizationId ASC, userId ASC, rejectedAt DESC]
 */
